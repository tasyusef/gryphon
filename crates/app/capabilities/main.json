{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Gryphon's commands (src/names.rs). Nothing else, not even the updater plugin's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-library",
    "allow-check-updates",
    "allow-install",
    "allow-add-github",
    "allow-search-curseforge",
    "allow-add-curseforge",
    "allow-update-all",
    "allow-remove",
    "allow-choose-game-folder",
    "allow-auto-game-folder",
    "allow-open-folder",
    "allow-open-github",
    "allow-open-curseforge",
    "allow-graphics",
    "allow-set-graphics",
    "allow-settings",
    "allow-set-light",
    "allow-set-token",
    "allow-set-curseforge-key",
    "allow-check-app-update",
    "allow-install-app-update",
    "allow-restart-app"
  ]
}
