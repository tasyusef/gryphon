{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gryphon",
  "identifier": "com.timothyali.gryphon",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": {
      "script": "trunk serve --port 5190",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gryphon",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#11110e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Timothy Ali",
    "category": "Utility",
    "shortDescription": "WoW Forever addons from GitHub.",
    "longDescription": "Installs and updates World of Warcraft: Forever addons straight from their GitHub releases. No CurseForge, no account, no ads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
