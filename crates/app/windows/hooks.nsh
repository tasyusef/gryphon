; The installer in Gryphon's illuminated colours (crates/ui/styles/brand.css). Tauri includes this
; file before Modern UI sets up its pages, so these take the place of its white and black.
; The pictures are icons/installer/, drawn by scripts/installer-art.py.
!define MUI_BGCOLOR "EFE4CC"                       ; vellum: the header and the welcome and finish pages
!define MUI_TEXTCOLOR "1D1712"                     ; iron-gall ink
!define MUI_HEADERIMAGE_RIGHT                      ; the G in its box at the header's right edge
!define MUI_INSTFILESPAGE_COLORS "1D1712 EFE4CC"   ; the list of what's being installed
